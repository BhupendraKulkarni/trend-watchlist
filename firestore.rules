rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can read the latest scan results — needed for the dashboard to load data
    match /watchlist/{doc} {
      allow read: if true;
      allow write: if false; // only the Cloud Function (Admin SDK) can write, bypasses rules
    }

    // Config is readable so you can see current settings, but not writable from the browser
    match /config/{doc} {
      allow read: if true;
      allow write: if false; // update capital/risk % via Firebase Console or Admin SDK
    }

    // Positions: anyone can read (it's your own dashboard), but only a signed-in user
    // can add/close a position. Good enough for solo use — the scan script (Admin SDK)
    // bypasses this entirely to update currentPrice/action daily.
    match /positions/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
